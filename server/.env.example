# ===============================================
# SteezeDrip Backend Configuration
# ===============================================

# Port to run the server on
PORT=5000

# PostgreSQL Database Connection String
# (e.g. from Neon.tech, Railway, or Render Postgres)
DATABASE_URL=postgresql://username:password@ep-something.neon.tech/steezedrip?sslmode=require

# Paystack API Keys (from your Paystack Dashboard -> Settings -> API Keys & Webhooks)
# Use 'sk_test_...' and 'pk_test_...' while testing, and 'sk_live_...' when ready to take real money!
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# Cloudinary Configuration for Direct Image Uploads
# (Sign up free at cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Dashboard Security
# Choose any strong secret password/passkey you want for logging into your admin page
ADMIN_SECRET_KEY=steezedrip_admin_pass_2025
JWT_SECRET=steezedrip_jwt_super_secret_salt_99
